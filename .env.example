# Polymarket API Configuration
# Your Ethereum private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Your wallet address (the funder address)
WALLET_ADDRESS=your_wallet_address_here

# Signature type: 0 for EOA (MetaMask/hardware), 1 for Email/Magic wallets
SIGNATURE_TYPE=0

# Maximum bet size in USDC per order
MAX_BET_SIZE=10.0

# Optional: Specific market condition IDs to trade (comma-separated)
# Leave empty to auto-select liquid markets
MARKET_IDS=

# Dry run mode - set to true to simulate without placing real orders
DRY_RUN=true
